{%- comment -%}
  Section contract.
  Eight Roma — Casting "Humans only". Path: sections/er-casting.liquid
  Pagina di candidatura al casting: a sinistra info (claim, date, negozi, passaggi),
  a destra l'area per il blocco app del form (Shopify Forms, con campo foto).
  @example
  <!-- Pagina "Casting" con template page.casting; QR delle affissioni → /pages/casting -->
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  capture form_area
    content_for 'blocks'
  endcapture
  assign form_area_stripped = form_area | strip
-%}

<div
  class="er-casting"
  style="
    --er-c-bg: {{ s.bg_color }};
    --er-c-fg: {{ s.text_color }};
    --er-c-form-bg: {{ s.form_bg_color }};
    --er-c-form-fg: {{ s.form_text_color }};
  "
>
  <div class="er-casting__info">
    {%- if s.eyebrow != blank -%}
      <p class="er-casting__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="er-casting__title">{{ s.heading | escape }}</h1>

    {%- if s.subheading != blank -%}
      <p class="er-casting__sub">{{ s.subheading | escape | newline_to_br }}</p>
    {%- endif -%}

    <dl class="er-casting__facts">
      {%- if s.dates != blank -%}
        <div class="er-casting__fact">
          <dt>{{ s.dates_label | escape }}</dt>
          <dd>{{ s.dates | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if s.places != blank -%}
        <div class="er-casting__fact">
          <dt>{{ s.places_label | escape }}</dt>
          <dd>{{ s.places | escape | newline_to_br }}</dd>
        </div>
      {%- endif -%}
    </dl>

    <ol class="er-casting__steps">
      {%- if s.step_1 != blank -%}<li><span>01</span>{{ s.step_1 | escape }}</li>{%- endif -%}
      {%- if s.step_2 != blank -%}<li><span>02</span>{{ s.step_2 | escape }}</li>{%- endif -%}
      {%- if s.step_3 != blank -%}<li><span>03</span>{{ s.step_3 | escape }}</li>{%- endif -%}
    </ol>

    {%- if s.note != blank -%}
      <div class="er-casting__note">{{ s.note }}</div>
    {%- endif -%}
  </div>

  <div class="er-casting__form">
    {%- if s.form_heading != blank -%}
      <h2 class="er-casting__form-title">{{ s.form_heading | escape }}</h2>
    {%- endif -%}

    {%- if form_area_stripped != blank -%}
      {{ form_area }}
    {%- elsif request.design_mode -%}
      <p class="er-casting__placeholder">
        Aggiungi qui il blocco app di Shopify Forms (Aggiungi blocco → App) con il form del casting.
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .er-casting {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--er-c-bg);
    color: var(--er-c-fg);
  }

  .er-casting__info,
  .er-casting__form {
    min-width: 0;
    padding: 48px 20px;
  }

  .er-casting__info {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .er-casting__eyebrow,
  .er-casting__facts dt,
  .er-casting__steps span {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .er-casting__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(56px, 13vw, 168px);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    overflow-wrap: normal;
    word-break: keep-all;
    color: inherit;
  }

  .er-casting__sub {
    margin: 0;
    max-width: 32ch;
    font-family: var(--font-body--family);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
    line-height: 1.25;
  }

  .er-casting__facts {
    display: grid;
    gap: 16px;
    margin: 0;
    border-block-start: 2px solid currentColor;
    padding-block-start: 16px;
  }

  .er-casting__fact {
    display: grid;
    gap: 4px;
  }

  .er-casting__facts dd {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.35;
  }

  .er-casting__steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .er-casting__steps li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    border-block-start: 1px solid currentColor;
    padding-block: 12px;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.4;
  }

  .er-casting__note {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.45;
    opacity: 0.8;
  }

  .er-casting__note p {
    margin: 0;
  }

  .er-casting__form {
    background: var(--er-c-form-bg);
    color: var(--er-c-form-fg);
  }

  .er-casting__form-title {
    margin: 0 0 24px;
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: inherit;
  }

  .er-casting__placeholder {
    padding: 16px;
    border: 1px dashed currentColor;
    font-size: 14px;
  }

  @media screen and (min-width: 990px) {
    .er-casting {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 100svh;
    }

    .er-casting__info {
      position: sticky;
      inset-block-start: 0;
      align-self: start;
      min-height: 100svh;
      justify-content: space-between;
      padding: 64px 56px;
    }

    .er-casting__form {
      padding: 64px 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ER · Casting",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header", "content": "Contenuto" },
    { "type": "text", "id": "eyebrow", "label": "Occhiello", "default": "Casting · Roma" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Humans only." },
    { "type": "textarea", "id": "subheading", "label": "Sottotitolo", "default": "Cerchiamo volti veri di Roma. Zero IA." },
    { "type": "text", "id": "dates_label", "label": "Etichetta date", "default": "Quando" },
    { "type": "text", "id": "dates", "label": "Date del casting", "default": "10–20 gennaio 2027" },
    { "type": "text", "id": "places_label", "label": "Etichetta luoghi", "default": "Dove" },
    { "type": "textarea", "id": "places", "label": "Negozi", "default": "Via del Gambero 34 — Centro storico\nVia Euripide — Axa" },
    { "type": "header", "content": "Passaggi" },
    { "type": "text", "id": "step_1", "label": "Passaggio 01", "default": "Compila il form e carica una foto vera." },
    { "type": "text", "id": "step_2", "label": "Passaggio 02", "default": "Ti chiamiamo e ti diamo giorno e ora." },
    { "type": "text", "id": "step_3", "label": "Passaggio 03", "default": "Vieni in negozio per il casting." },
    { "type": "richtext", "id": "note", "label": "Nota", "default": "<p>Solo persone maggiorenni. La foto deve essere reale: niente immagini generate o ritoccate con l’IA.</p>" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Titolo del form", "default": "Candidati" },
    { "type": "header", "content": "Colori" },
    { "type": "color", "id": "bg_color", "label": "Sfondo info", "default": "#151412" },
    { "type": "color", "id": "text_color", "label": "Testo info", "default": "#EEE9E0" },
    { "type": "color", "id": "form_bg_color", "label": "Sfondo form", "default": "#EEE9E0" },
    { "type": "color", "id": "form_text_color", "label": "Testo form", "default": "#151412" }
  ],
  "presets": [
    { "name": "ER · Casting" }
  ]
}
{% endschema %}
